<Window x:Class="CloCloWidget.WindowsStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Windows status" Width="360" Height="290"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Windows status" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock x:Name="ConnectionText" Text="Checking…" TextWrapping="Wrap" />
            <TextBlock Text="Checks the local connection only; internet access is not tested."
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <GroupBox Grid.Row="2" Header="Fixed drives" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DrivesText" Text="Checking…" TextWrapping="Wrap" />
            </ScrollViewer>
        </GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" MinWidth="72" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="Close" MinWidth="72" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
