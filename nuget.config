<?xml version="1.0" encoding="utf-8"?>
<!--
  Package supply-chain settings for CloClo.
  - Only nuget.org is used, and every package is mapped to it, so no other
    feed configured on this machine can supply (or substitute) a package.
  - signatureValidationMode=require: a package is only accepted if it carries
    a valid signature from a trusted signer below. nuget.org repository-signs
    every package it serves, so this rejects unsigned or re-packed packages.
    (NuGet checks signatures when it extracts a package into the cache.)
  The nuget.org certificate fingerprints below were added by running
  "dotnet nuget trust source nuget.org" with the configfile option pointing
  at this file. Run that again if nuget.org ever renews its repository
  certificate.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
        <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
        <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
        <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      </repository>
  </trustedSigners>
</configuration>
