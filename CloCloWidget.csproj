<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- No Windows Forms: the tray icon, menus, screen and power queries are
         WPF or plain Windows calls (TrayIcon.cs, NativeScreen.cs), which
         keeps Windows Forms' ~22 MB out of the build. -->
    <ApplicationManifest>config\app.manifest</ApplicationManifest>
    <AssemblyName>CloCloWidget</AssemblyName>
    <RootNamespace>CloCloWidget</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Program.Main, not WPF's generated one: it verifies the extracted
         native DLLs before WPF loads them (see NativeLibraryCheck.cs). -->
    <StartupObject>CloCloWidget.Program</StartupObject>
    <!-- Ignore DOTNET_STARTUP_HOOKS: that variable otherwise makes .NET run
         any DLL's code before Main, ahead of every check in it. -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- Size: only the English resources of WPF (CloClo's
         own text is English) - the 13 other languages added ~17 MB. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Memory: no background (concurrent) garbage collector. A widget's
         heap is small, so a collection pauses for a few milliseconds at
         most, and dropping the background GC thread and its reserve saved
         ~6 MB of private memory and kept the working set from creeping up.
         (The single-file bundle is deliberately NOT compressed: that halves
         the exe but decompresses everything into private memory - measured
         at +80 MB.) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- The CPU runtime is copied as four explicit win-x64 files below. Its
         default build target copies other architectures into subdirectories. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
    <!-- The Vulkan runtime is a complete second set with the same file names,
         copied as five explicit files into gpu\ below. It is loaded instead
         of the CPU set only when a dedicated GPU is found (see
         LocalAudioTranscriber.EnsureNativeRuntimeLoaded). -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="$(IntermediateOutputPath)whisper-runtime\ggml-base-whisper.dll;$(IntermediateOutputPath)whisper-runtime\ggml-cpu-whisper.dll;$(IntermediateOutputPath)whisper-runtime\ggml-whisper.dll;$(IntermediateOutputPath)whisper-runtime\whisper.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- Published by CopyWhisperRuntimeToPublish into gpu\, never bundled. -->
    <Content Include="$(IntermediateOutputPath)whisper-runtime\gpu\ggml-base-whisper.dll;$(IntermediateOutputPath)whisper-runtime\gpu\ggml-cpu-whisper.dll;$(IntermediateOutputPath)whisper-runtime\gpu\ggml-vulkan-whisper.dll;$(IntermediateOutputPath)whisper-runtime\gpu\ggml-whisper.dll;$(IntermediateOutputPath)whisper-runtime\gpu\whisper.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Link="gpu\%(Filename)%(Extension)" />
    <Content Include="$(ArabicWhisperModel)" Link="ggml-large-v3-turbo-q5_0.bin"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Arabic dictation on a dedicated GPU uses large-v3-turbo (q5_0). At
       574 MB it is not kept in git: the build downloads it once from a fixed
       Hugging Face revision into obj\whisper-models\ and accepts only these
       exact bytes. obj\ is outside the source record, so check-source.ps1 is
       unaffected. PlaybackModelStore checks the same size and SHA-256 again
       before every use. -->
  <PropertyGroup>
    <ArabicWhisperModelDir>$(MSBuildProjectDirectory)\obj\whisper-models\</ArabicWhisperModelDir>
    <ArabicWhisperModel>$(ArabicWhisperModelDir)ggml-large-v3-turbo-q5_0.bin</ArabicWhisperModel>
    <ArabicWhisperModelSha256>394221709CD5AD1F40C46E6031CA61BCE88931E6E088C188294C6D5A55FFA7E2</ArabicWhisperModelSha256>
    <ArabicWhisperModelUrl>https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-large-v3-turbo-q5_0.bin</ArabicWhisperModelUrl>
  </PropertyGroup>

  <Target Name="FetchArabicWhisperModel" BeforeTargets="CoreCompile" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup><_ArabicModelPartial>$(ArabicWhisperModel).download</_ArabicModelPartial></PropertyGroup>
    <Delete Files="$(_ArabicModelPartial)" Condition="!Exists('$(ArabicWhisperModel)')" />
    <Message Importance="high" Condition="!Exists('$(ArabicWhisperModel)')"
             Text="Downloading the pinned Arabic Whisper model (574 MB, once)..." />
    <DownloadFile Condition="!Exists('$(ArabicWhisperModel)')" SourceUrl="$(ArabicWhisperModelUrl)"
                  DestinationFolder="$(ArabicWhisperModelDir)" DestinationFileName="ggml-large-v3-turbo-q5_0.bin.download"
                  Retries="2" RetryDelayMilliseconds="5000" />
    <GetFileHash Files="$(_ArabicModelPartial)" Algorithm="SHA256" Condition="Exists('$(_ArabicModelPartial)')">
      <Output TaskParameter="Items" ItemName="_ArabicModelDownloadHash" />
    </GetFileHash>
    <Delete Files="$(_ArabicModelPartial)" Condition="Exists('$(_ArabicModelPartial)') and '@(_ArabicModelDownloadHash->'%(FileHash)')' != '$(ArabicWhisperModelSha256)'" />
    <Error Condition="!Exists('$(ArabicWhisperModel)') and !Exists('$(_ArabicModelPartial)')"
           Text="The downloaded Arabic Whisper model did not match its pinned SHA-256 and was deleted." />
    <Move SourceFiles="$(_ArabicModelPartial)" DestinationFiles="$(ArabicWhisperModel)" Condition="Exists('$(_ArabicModelPartial)')" />
    <GetFileHash Files="$(ArabicWhisperModel)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ArabicModelHash" />
    </GetFileHash>
    <Error Condition="'@(_ArabicModelHash->'%(FileHash)')' != '$(ArabicWhisperModelSha256)'"
           Text="$(ArabicWhisperModel) is altered or incomplete. Delete it and build again to download the pinned model." />
  </Target>

  <!-- Keep the verified model as a separate installed data file. Bundling it
       into the exe would inflate the executable and duplicate it in memory. -->
  <ItemGroup>
    <Content Include="Assets\Models\ggml-base.bin" Link="ggml-base.bin"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="VerifyBundledWhisperModel" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Assets\Models\ggml-base.bin')"
           Text="The bundled Whisper model is missing. Run git lfs pull before building." />
    <GetFileHash Files="$(MSBuildProjectDirectory)\Assets\Models\ggml-base.bin" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BundledModelHash" />
    </GetFileHash>
    <Error Condition="'%(_BundledModelHash.FileHash)' != '60ED5BC3DD14EEA856493D334349B405782DDCAF0028D4B5DF4088345FBA2EFE'"
           Text="The bundled Whisper model is incomplete or altered. Run git lfs pull to restore the pinned model." />
  </Target>

  <Target Name="PrepareWhisperRuntime" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\ggml-base-whisper.dll" ExpectedHash="E6C362421B6D5A5C1B52341F88D3D72764DE29F05141748CC3FAAD2F6348063F" />
      <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\ggml-cpu-whisper.dll" ExpectedHash="480A23AFC6DEEA301C5CDA66CF462FA2F2EB7FF9BCA63B8F4F933A0E8DC5D4DD" />
      <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\ggml-whisper.dll" ExpectedHash="2E0AC238C2BC178A5C1F09B3BDE2421904B191BCE1CC1C13DC64309CA3B9CB36" />
      <_WhisperSource Include="$(PkgWhisper_net_Runtime)\build\win-x64\whisper.dll" ExpectedHash="07EC2FAC4946005BA7380F2C2E9CCFA3AD23007592D074AA698ED5DF6BFB4938" />
    </ItemGroup>
    <GetFileHash Files="@(_WhisperSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WhisperSourceHash" />
    </GetFileHash>
    <Error Condition="'%(_WhisperSourceHash.FileHash)' != '%(_WhisperSourceHash.ExpectedHash)'"
           Text="Whisper CPU runtime differs from the pinned 1.9.1 package: %(_WhisperSourceHash.Identity)" />
    <PropertyGroup><_WhisperOut>$(IntermediateOutputPath)whisper-runtime\</_WhisperOut></PropertyGroup>
    <RemoveDir Directories="$(_WhisperOut)" />
    <MakeDir Directories="$(_WhisperOut)" />
    <Copy SourceFiles="@(_WhisperSource)" DestinationFolder="$(_WhisperOut)" />
    <ItemGroup>
      <_WhisperCopy Include="$(_WhisperOut)ggml-base-whisper.dll;$(_WhisperOut)ggml-cpu-whisper.dll;$(_WhisperOut)ggml-whisper.dll;$(_WhisperOut)whisper.dll" />
    </ItemGroup>
    <ItemGroup>
      <_WhisperGpuSource Include="$(PkgWhisper_net_Runtime_Vulkan)\build\win-x64\ggml-base-whisper.dll" ExpectedHash="0FAFF6AB28A1E10DFC7319DC92608259D1F68AACB897B8DBFF60323DCE46BCB8" />
      <_WhisperGpuSource Include="$(PkgWhisper_net_Runtime_Vulkan)\build\win-x64\ggml-cpu-whisper.dll" ExpectedHash="98120D5EBB99BEB37A319D9DE624FFDB61BFE528A9829F9A6A1A55AF3DAB06C5" />
      <_WhisperGpuSource Include="$(PkgWhisper_net_Runtime_Vulkan)\build\win-x64\ggml-vulkan-whisper.dll" ExpectedHash="E325725C18B88BED00443A2CA4AC3D6FDB7587FB055B52C623DF3B04E87FB039" />
      <_WhisperGpuSource Include="$(PkgWhisper_net_Runtime_Vulkan)\build\win-x64\ggml-whisper.dll" ExpectedHash="4566056B3A710FFDF89C7627AA3AB7A73FB0F78374E14F13198628DCBF27CC2D" />
      <_WhisperGpuSource Include="$(PkgWhisper_net_Runtime_Vulkan)\build\win-x64\whisper.dll" ExpectedHash="56FE7C2E626FC0C981E87638D3E8C8BEC39DE8877636AC885929212B81DDB9ED" />
    </ItemGroup>
    <GetFileHash Files="@(_WhisperGpuSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WhisperGpuSourceHash" />
    </GetFileHash>
    <Error Condition="'%(_WhisperGpuSourceHash.FileHash)' != '%(_WhisperGpuSourceHash.ExpectedHash)'"
           Text="Whisper Vulkan runtime differs from the pinned 1.9.1 package: %(_WhisperGpuSourceHash.Identity)" />
    <MakeDir Directories="$(_WhisperOut)gpu\" />
    <Copy SourceFiles="@(_WhisperGpuSource)" DestinationFolder="$(_WhisperOut)gpu\" />
    <ItemGroup>
      <_WhisperGpuCopy Include="$(_WhisperOut)gpu\ggml-base-whisper.dll;$(_WhisperOut)gpu\ggml-cpu-whisper.dll;$(_WhisperOut)gpu\ggml-vulkan-whisper.dll;$(_WhisperOut)gpu\ggml-whisper.dll;$(_WhisperOut)gpu\whisper.dll" />
    </ItemGroup>
    <!-- WPF compiles a temporary *_wpftmp.csproj for markup references. It
         does not ship, so signing its disposable runtime copies would prompt
         for the protected key a second time. The real publish signs and pins
         its own copies below. -->
    <Exec Condition="'$(_SignEnabled)' == 'true' and !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))"
          Command="$(_SignCommand) -Path &quot;%(_WhisperCopy.FullPath)&quot;" />
    <Exec Condition="'$(_SignEnabled)' == 'true' and !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))"
          Command="$(_SignCommand) -Path &quot;%(_WhisperGpuCopy.FullPath)&quot;" />
  </Target>

  <!--
    Pins the exact native runtime files this build ships: every native DLL
    from the runtime packs, by name and SHA-256, compiled into the exe as
    NativeLibraryPins.g.cs. NativeLibraryCheck accepts nothing else in the
    folder the single-file exe extracts them to. Builds without a runtime
    identifier (plain dotnet build) get an empty list, and don't extract
    anything anyway.
  -->
  <Target Name="GenerateNativeLibraryPins" BeforeTargets="CoreCompile" DependsOnTargets="ProcessFrameworkReferences;ResolveRuntimePackAssets;PrepareWhisperRuntime">
    <ItemGroup>
      <_NativePinCandidate Include="@(RuntimePackAsset)" Condition="'%(RuntimePackAsset.AssetType)' == 'native' and '%(RuntimePackAsset.Extension)' == '.dll'" />
    </ItemGroup>
    <!-- First prove each of them is byte-for-byte the file inside its signed
         NuGet package (verify-pins.ps1): the unpacked cache is writable by
         any program running as this user, and whatever is there now gets
         pinned as genuine. dotnet is run from Program Files, not via PATH. -->
    <PropertyGroup>
      <_PinListFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)native-pin-candidates.txt</_PinListFile>
      <_PinDotnet>$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.ProgramFiles)), 'dotnet', 'dotnet.exe'))</_PinDotnet>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PinListFile)" Lines="@(_NativePinCandidate->'%(FullPath)')" Overwrite="true" Condition="'@(_NativePinCandidate)' != ''" />
    <Exec Condition="'@(_NativePinCandidate)' != ''"
          Command="&quot;$(_SignPowerShell)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\verify-pins.ps1&quot; -ListFile &quot;$(_PinListFile)&quot; -Dotnet &quot;$(_PinDotnet)&quot;" />
    <GetFileHash Files="@(_NativePinCandidate)" Algorithm="SHA256" Condition="'@(_NativePinCandidate)' != ''">
      <Output TaskParameter="Items" ItemName="_NativePin" />
    </GetFileHash>
    <GetFileHash Files="@(_WhisperCopy)" Algorithm="SHA256" Condition="'@(_WhisperCopy)' != ''">
      <Output TaskParameter="Items" ItemName="_WhisperPin" />
    </GetFileHash>
    <GetFileHash Files="@(_WhisperGpuCopy)" Algorithm="SHA256" Condition="'@(_WhisperGpuCopy)' != ''">
      <Output TaskParameter="Items" ItemName="_WhisperGpuPin" />
    </GetFileHash>
    <PropertyGroup>
      <_NativePinsFile>$(IntermediateOutputPath)NativeLibraryPins.g.cs</_NativePinsFile>
    </PropertyGroup>
    <ItemGroup>
      <_NativePinLine Include="// Generated by GenerateNativeLibraryPins in CloCloWidget.csproj - do not edit." />
      <_NativePinLine Include="namespace CloCloWidget%3B" />
      <_NativePinLine Include="public static partial class NativeLibraryCheck" />
      <_NativePinLine Include="{" />
      <_NativePinLine Include="    private static readonly System.Collections.Generic.HashSet&lt;string&gt; PinnedLibraries = new(System.StringComparer.OrdinalIgnoreCase)" />
      <_NativePinLine Include="    {" />
      <_NativePinLine Include="@(_NativePin->'        &quot;%(Filename)%(Extension)|%(FileHash)&quot;,')" />
      <_NativePinLine Include="    }%3B" />
      <_NativePinLine Include="    private static readonly System.Collections.Generic.HashSet&lt;string&gt; PinnedWhisperLibraries = new(System.StringComparer.OrdinalIgnoreCase)" />
      <_NativePinLine Include="    {" />
      <_NativePinLine Include="@(_WhisperPin->'        &quot;%(Filename)%(Extension)|%(FileHash)&quot;,')" />
      <_NativePinLine Include="    }%3B" />
      <_NativePinLine Include="    private static readonly System.Collections.Generic.HashSet&lt;string&gt; PinnedWhisperGpuLibraries = new(System.StringComparer.OrdinalIgnoreCase)" />
      <_NativePinLine Include="    {" />
      <_NativePinLine Include="@(_WhisperGpuPin->'        &quot;%(Filename)%(Extension)|%(FileHash)&quot;,')" />
      <_NativePinLine Include="    }%3B" />
      <_NativePinLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_NativePinsFile)" Lines="@(_NativePinLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_NativePinsFile)" />
      <FileWrites Include="$(_NativePinsFile)" />
    </ItemGroup>
  </Target>

  <!--
    Opt-in Authenticode signing, done by sign.ps1 (install.ps1 drives it).
    Runs only when a protected certificate or Artifact Signing is given:
      -p:SignCertThumbprint=<sha1>   a code-signing cert in the "My" store
                                     (also where hardware tokens expose theirs)
      -p:SignMetadataFile=<json> -p:SignDlibPath=<Azure.CodeSigning.Dlib.dll>
                                     Microsoft Artifact Signing (formerly Azure
                                     Trusted Signing); publicly trusted
      -p:SignRequireTrusted=true     fail unless every signature chains to a
                                     root the PC already trusts (build-msix.ps1)
    Two stages, because a single-file publish packs every DLL inside the exe:
      1. SignBundledBinaries — just before bundling, signs copies of every
         DLL that isn't already validly signed (CloCloWidget.dll and any
         unsigned third-party library), and bundles those copies instead.
      2. SignPublishedExe — signs the finished CloCloWidget.exe.
    Signatures are RFC 3161 timestamped (valid after the cert expires) and
    checked straight after signing; a failure fails the build.
  -->
  <PropertyGroup>
    <_SignEnabled Condition="'$(SignCertThumbprint)' != '' or '$(SignMetadataFile)' != ''">true</_SignEnabled>
    <_SignScript>&quot;$(MSBuildProjectDirectory)\scripts\sign.ps1&quot;</_SignScript>
    <_SignCertArgs Condition="'$(SignCertThumbprint)' != ''">-Thumbprint $(SignCertThumbprint)</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignMetadataFile)' != ''">$(_SignCertArgs) -SigningMetadata &quot;$(SignMetadataFile)&quot; -SigningDlib &quot;$(SignDlibPath)&quot;</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignRequireTrusted)' == 'true'">$(_SignCertArgs) -RequireTrusted</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignToolPath)' != ''">$(_SignCertArgs) -SignTool &quot;$(SignToolPath)&quot;</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignTimestampUrl)' != ''">$(_SignCertArgs) -TimestampUrl $(SignTimestampUrl)</_SignCertArgs>
    <!-- Full path, not "powershell.exe": a bare name is looked up through
         PATH, where another program could put a look-alike that then gets
         to hand its own files to the signing key. -->
    <_SignPowerShell>$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.System)), 'WindowsPowerShell', 'v1.0', 'powershell.exe'))</_SignPowerShell>
    <_SignCommand>&quot;$(_SignPowerShell)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $(_SignScript) $(_SignCertArgs)</_SignCommand>
  </PropertyGroup>

  <Target Name="RejectPfxSigning" BeforeTargets="PrepareForBuild"
          Condition="'$(SignCertFile)' != ''">
    <Error Text="File-based signing has been removed. Use SignCertThumbprint with a protected certificate in the Windows store." />
  </Target>

  <Target Name="SignBundledBinaries" AfterTargets="PrepareForBundle" Condition="'$(_SignEnabled)' == 'true'">
    <PropertyGroup>
      <_SignWorkDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)signed\</_SignWorkDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- These four files are already signed by PrepareWhisperRuntime and
           copied beside the exe, where startup pins them. Do not also put
           copies inside the single-file bundle or re-evaluate their locally
           untrusted self-signed certificate in sign.ps1. -->
      <_WhisperExternal Include="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == 'ggml-base-whisper.dll' or '%(Filename)%(Extension)' == 'ggml-cpu-whisper.dll' or '%(Filename)%(Extension)' == 'ggml-vulkan-whisper.dll' or '%(Filename)%(Extension)' == 'ggml-whisper.dll' or '%(Filename)%(Extension)' == 'whisper.dll'" />
      <FilesToBundle Remove="@(_WhisperExternal)" />
      <!-- DLLs only: the one .exe in here is the host stub the bundle gets
           appended to, and a signature on it would be broken by that —
           it's signed once, as the finished exe, by SignPublishedExe. -->
      <_SignCandidate Include="@(FilesToBundle)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
    <RemoveDir Directories="$(_SignWorkDir)" />
    <MakeDir Directories="$(_SignWorkDir)" />
    <WriteLinesToFile File="$(_SignWorkDir)bundle.txt" Lines="@(_SignCandidate->'%(FullPath)|%(RelativePath)')" Overwrite="true" />
    <Exec Command="$(_SignCommand) -BundleList &quot;$(_SignWorkDir)bundle.txt&quot; -OutDir &quot;$(_SignWorkDir)files&quot; -SignedList &quot;$(_SignWorkDir)signed.txt&quot;" />
    <ReadLinesFromFile File="$(_SignWorkDir)signed.txt">
      <Output TaskParameter="Lines" ItemName="_SignedLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <!-- The bundle items that were signed, found by RelativePath (their
           place inside the bundle) — item paths here mix absolute and
           project-relative forms, so matching on those misses some. -->
      <_SignedRelative Include="@(_SignedLine)" RelativePath="%(Identity)" />
      <_SignUntouched Include="@(FilesToBundle)" />
      <_SignUntouched Remove="@(_SignedRelative)" MatchOnMetadata="RelativePath" />
      <_SignReplaced Include="@(FilesToBundle)" />
      <_SignReplaced Remove="@(_SignUntouched)" MatchOnMetadata="RelativePath" />
      <!-- ...swapped for their signed copies (a transform keeps metadata). -->
      <FilesToBundle Remove="@(_SignReplaced)" MatchOnMetadata="RelativePath" />
      <FilesToBundle Include="@(_SignReplaced->'$(_SignWorkDir)files\%(RelativePath)')" />
    </ItemGroup>
  </Target>

  <!-- The bundler consumes Content DLLs unless they are removed above. Copy
       the already signed and pinned CPU DLLs explicitly beside the exe. This
       keeps one verified copy in the install rather than a hidden duplicate
       inside the bundle. -->
  <Target Name="CopyWhisperRuntimeToPublish" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '@(_WhisperCopy)' != ''">
    <Copy SourceFiles="@(_WhisperCopy)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(_WhisperGpuCopy)" DestinationFolder="$(PublishDir)gpu\" />
  </Target>

  <Target Name="SignPublishedExe" AfterTargets="Publish" DependsOnTargets="CopyWhisperRuntimeToPublish" Condition="'$(_SignEnabled)' == 'true'">
    <Exec Command="$(_SignCommand) -Path &quot;$([System.IO.Path]::GetFullPath('$(PublishDir)$(AssemblyName).exe'))&quot;" />
  </Target>

</Project>
