<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CloCloWidget</AssemblyName>
    <RootNamespace>CloCloWidget</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Program.Main, not WPF's generated one: it verifies the extracted
         native DLLs before WPF loads them (see NativeLibraryCheck.cs). -->
    <StartupObject>CloCloWidget.Program</StartupObject>
    <!-- Ignore DOTNET_STARTUP_HOOKS: that variable otherwise makes .NET run
         any DLL's code before Main, ahead of every check in it. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!--
    Pins the exact native runtime files this build ships: every native DLL
    from the runtime packs, by name and SHA-256, compiled into the exe as
    NativeLibraryPins.g.cs. NativeLibraryCheck accepts nothing else in the
    folder the single-file exe extracts them to. Builds without a runtime
    identifier (plain dotnet build) get an empty list, and don't extract
    anything anyway.
  -->
  <Target Name="GenerateNativeLibraryPins" BeforeTargets="CoreCompile" DependsOnTargets="ProcessFrameworkReferences;ResolveRuntimePackAssets">
    <ItemGroup>
      <_NativePinCandidate Include="@(RuntimePackAsset)" Condition="'%(RuntimePackAsset.AssetType)' == 'native' and '%(RuntimePackAsset.Extension)' == '.dll'" />
    </ItemGroup>
    <GetFileHash Files="@(_NativePinCandidate)" Algorithm="SHA256" Condition="'@(_NativePinCandidate)' != ''">
      <Output TaskParameter="Items" ItemName="_NativePin" />
    </GetFileHash>
    <PropertyGroup>
      <_NativePinsFile>$(IntermediateOutputPath)NativeLibraryPins.g.cs</_NativePinsFile>
    </PropertyGroup>
    <ItemGroup>
      <_NativePinLine Include="// Generated by GenerateNativeLibraryPins in CloCloWidget.csproj - do not edit." />
      <_NativePinLine Include="namespace CloCloWidget%3B" />
      <_NativePinLine Include="public static partial class NativeLibraryCheck" />
      <_NativePinLine Include="{" />
      <_NativePinLine Include="    private static readonly System.Collections.Generic.HashSet&lt;string&gt; PinnedLibraries = new(System.StringComparer.OrdinalIgnoreCase)" />
      <_NativePinLine Include="    {" />
      <_NativePinLine Include="@(_NativePin->'        &quot;%(Filename)%(Extension)|%(FileHash)&quot;,')" />
      <_NativePinLine Include="    }%3B" />
      <_NativePinLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_NativePinsFile)" Lines="@(_NativePinLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_NativePinsFile)" />
      <FileWrites Include="$(_NativePinsFile)" />
    </ItemGroup>
  </Target>

  <!--
    Opt-in Authenticode signing, done by sign.ps1 (install.ps1 drives it).
    Runs only when a certificate is given:
      -p:SignCertThumbprint=<sha1>   a code-signing cert in the "My" store
                                     (also where hardware tokens and cloud
                                     signing providers expose theirs), or
      -p:SignCertFile=<path.pfx>     password in env var SIGN_CERT_PASSWORD
    Two stages, because a single-file publish packs every DLL inside the exe:
      1. SignBundledBinaries — just before bundling, signs copies of every
         DLL that isn't already validly signed (CloCloWidget.dll and any
         unsigned third-party library), and bundles those copies instead.
      2. SignPublishedExe — signs the finished CloCloWidget.exe.
    Signatures are RFC 3161 timestamped (valid after the cert expires) and
    checked straight after signing; a failure fails the build.
  -->
  <PropertyGroup>
    <_SignEnabled Condition="'$(SignCertThumbprint)' != '' or '$(SignCertFile)' != ''">true</_SignEnabled>
    <_SignScript>&quot;$(MSBuildProjectDirectory)\sign.ps1&quot;</_SignScript>
    <_SignCertArgs Condition="'$(SignCertThumbprint)' != ''">-Thumbprint $(SignCertThumbprint)</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignCertThumbprint)' == '' and '$(SignCertFile)' != ''">-PfxFile &quot;$([System.IO.Path]::GetFullPath('$(SignCertFile)'))&quot;</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignToolPath)' != ''">$(_SignCertArgs) -SignTool &quot;$(SignToolPath)&quot;</_SignCertArgs>
    <_SignCertArgs Condition="'$(SignTimestampUrl)' != ''">$(_SignCertArgs) -TimestampUrl $(SignTimestampUrl)</_SignCertArgs>
    <_SignCommand>powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $(_SignScript) $(_SignCertArgs)</_SignCommand>
  </PropertyGroup>

  <Target Name="SignBundledBinaries" AfterTargets="PrepareForBundle" Condition="'$(_SignEnabled)' == 'true'">
    <PropertyGroup>
      <_SignWorkDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)signed\</_SignWorkDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- DLLs only: the one .exe in here is the host stub the bundle gets
           appended to, and a signature on it would be broken by that —
           it's signed once, as the finished exe, by SignPublishedExe. -->
      <_SignCandidate Include="@(FilesToBundle)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
    <RemoveDir Directories="$(_SignWorkDir)" />
    <MakeDir Directories="$(_SignWorkDir)" />
    <WriteLinesToFile File="$(_SignWorkDir)bundle.txt" Lines="@(_SignCandidate->'%(FullPath)|%(RelativePath)')" Overwrite="true" />
    <Exec Command="$(_SignCommand) -BundleList &quot;$(_SignWorkDir)bundle.txt&quot; -OutDir &quot;$(_SignWorkDir)files&quot; -SignedList &quot;$(_SignWorkDir)signed.txt&quot;" />
    <ReadLinesFromFile File="$(_SignWorkDir)signed.txt">
      <Output TaskParameter="Lines" ItemName="_SignedLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <!-- The bundle items that were signed, found by RelativePath (their
           place inside the bundle) — item paths here mix absolute and
           project-relative forms, so matching on those misses some. -->
      <_SignedRelative Include="@(_SignedLine)" RelativePath="%(Identity)" />
      <_SignUntouched Include="@(FilesToBundle)" />
      <_SignUntouched Remove="@(_SignedRelative)" MatchOnMetadata="RelativePath" />
      <_SignReplaced Include="@(FilesToBundle)" />
      <_SignReplaced Remove="@(_SignUntouched)" MatchOnMetadata="RelativePath" />
      <!-- ...swapped for their signed copies (a transform keeps metadata). -->
      <FilesToBundle Remove="@(_SignReplaced)" MatchOnMetadata="RelativePath" />
      <FilesToBundle Include="@(_SignReplaced->'$(_SignWorkDir)files\%(RelativePath)')" />
    </ItemGroup>
  </Target>

  <Target Name="SignPublishedExe" AfterTargets="Publish" Condition="'$(_SignEnabled)' == 'true'">
    <Exec Command="$(_SignCommand) -Path &quot;$([System.IO.Path]::GetFullPath('$(PublishDir)$(AssemblyName).exe'))&quot;" />
  </Target>

</Project>
