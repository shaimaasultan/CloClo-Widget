<Window x:Class="CloCloWidget.QuranWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Quran memorization"
        Width="680" Height="820" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#241a10">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#2a2019" />
        <SolidColorBrush x:Key="Edge" Color="#8a6a2f" />
        <SolidColorBrush x:Key="Text" Color="#f3ecdd" />
        <SolidColorBrush x:Key="Muted" Color="#cbbfa8" />
        <SolidColorBrush x:Key="Accent" Color="#e6c476" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#c9a24b" />
            <Setter Property="Foreground" Value="#241e1a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3a2c1e" />
            <Setter Property="Foreground" Value="#f3ecdd" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Accent}">
                <TextBlock x:Name="HeaderGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Foreground="#241a10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Quran memorization" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="SurahSubtitle" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Surah and ayah pickers -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Surah" Style="{StaticResource Label}" Margin="0,0,8,0" />
            <ComboBox x:Name="SurahBox" Grid.Column="1" SelectionChanged="SurahBox_SelectionChanged"
                      AutomationProperties.Name="Surah" MaxDropDownHeight="360" />
            <TextBlock Grid.Column="2" Text="Ayah" Style="{StaticResource Label}" Margin="14,0,8,0" />
            <ComboBox x:Name="AyahBox" Grid.Column="3" Width="72" SelectionChanged="AyahBox_SelectionChanged"
                      AutomationProperties.Name="From ayah" MaxDropDownHeight="360" />
            <TextBlock Grid.Column="4" Text="to" Style="{StaticResource Label}" Margin="8,0,8,0" />
            <ComboBox x:Name="AyahEndBox" Grid.Column="5" Width="72" SelectionChanged="AyahEndBox_SelectionChanged"
                      AutomationProperties.Name="To ayah" MaxDropDownHeight="360"
                      ToolTip="Learn a run of up to 20 ayat together: they are recited one after another, then repeated." />
        </Grid>

        <!-- The ayah -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="12" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BasmalaText" Grid.Row="0" FontSize="22" Foreground="{StaticResource Accent}"
                           FontFamily="Sakkal Majalla, Arabic Typesetting, Traditional Arabic, Segoe UI"
                           FlowDirection="RightToLeft" TextAlignment="Center" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AyahText" FontSize="34" Foreground="{StaticResource Text}" LineHeight="58"
                                   FontFamily="Sakkal Majalla, Arabic Typesetting, Traditional Arabic, Segoe UI"
                                   FlowDirection="RightToLeft" TextAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.Name="Ayah text" />
                        <TextBlock x:Name="EnglishText" FontSize="15" Foreground="{StaticResource Muted}" LineHeight="22"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="12,14,12,0" Visibility="Collapsed"
                                   AutomationProperties.Name="English meaning" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RepeatText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MemorizedBadge" Text="✓ Memorized" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#9fd49f" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,14,0" />
                        <CheckBox x:Name="EnglishBox" Content="Show English" Foreground="{StaticResource Muted}" FontSize="13"
                                  VerticalAlignment="Center" Click="EnglishBox_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />

        <!-- Main actions -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="◀ Previous" Style="{StaticResource QuietButton}" Click="Previous_Click" />
            <Button x:Name="PlayButton" Grid.Column="1" Margin="8,0,0,0" Click="Play_Click" MinWidth="130" />
            <Button x:Name="MemorizedButton" Grid.Column="3" Click="Memorized_Click" Background="#5f8f4e" Foreground="#f3ecdd"
                    Content="✓ Memorized — next ayah" />
        </Grid>

        <!-- Progress -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <ProgressBar x:Name="SurahProgress" Height="8" Minimum="0" Background="#3a2c1e" Foreground="#c9a24b" BorderThickness="0" />
            <TextBlock x:Name="ProgressText" Margin="0,4,0,0" Style="{StaticResource Label}" />
        </StackPanel>

        <!-- Settings and attribution -->
        <StackPanel Grid.Row="6" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Reciter folder…" Style="{StaticResource QuietButton}" Click="ChooseFolder_Click" Padding="10,4" FontWeight="Normal" />
                <Button x:Name="UseInstalledButton" Grid.Column="1" Content="Use installed" Style="{StaticResource QuietButton}" Click="UseInstalled_Click"
                        Padding="10,4" FontWeight="Normal" Margin="6,0,0,0" Visibility="Collapsed"
                        ToolTip="Play the signed recitation pack installed with CloClo instead of the chosen folder" />
                <TextBlock x:Name="FolderText" Grid.Column="2" Style="{StaticResource Label}" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="Pause" Style="{StaticResource Label}" Margin="0,0,6,0" />
                <ComboBox x:Name="GapBox" Grid.Column="4" Width="64" SelectionChanged="GapBox_SelectionChanged" AutomationProperties.Name="Pause between repeats" />
                <TextBlock Grid.Column="5" Text="Remind" Style="{StaticResource Label}" Margin="12,0,6,0" />
                <ComboBox x:Name="ReminderBox" Grid.Column="6" Width="110" SelectionChanged="ReminderBox_SelectionChanged" AutomationProperties.Name="Avatar reminder" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="Close" Click="Close_Click" Background="#3c1512" Foreground="#f3ecdd" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
