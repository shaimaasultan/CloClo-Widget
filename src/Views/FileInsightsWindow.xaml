<Window x:Class="CloCloWidget.FileInsightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — File summary and search" Width="760" Height="620" MinWidth="560" MinHeight="460"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="File summary and search" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ChooseFolderButton" Content="Choose folder…" MinWidth="100" Margin="0,0,8,0" Click="ChooseFolder_Click" />
                <Button x:Name="ChooseFilesButton" Content="Choose files…" MinWidth="100" Margin="0,0,12,0" Click="ChooseFiles_Click" />
                <CheckBox x:Name="SubfoldersCheck" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center"
                          Click="Subfolders_Click" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="ScopeText" Grid.Row="1" Text="Choose a folder, or one or more files, to begin."
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

        <TabControl x:Name="Tabs" Grid.Row="2">
            <TabItem Header="Summary">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel><TextBlock Text="Files" Style="{StaticResource Muted}" /><TextBlock x:Name="FileCountText" Text="–" Style="{StaticResource TileValue}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel><TextBlock Text="Total size" Style="{StaticResource Muted}" /><TextBlock x:Name="TotalSizeText" Text="–" Style="{StaticResource TileValue}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel><TextBlock Text="Text files read" Style="{StaticResource Muted}" /><TextBlock x:Name="TextFilesText" Text="–" Style="{StaticResource TileValue}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel><TextBlock Text="Lines" Style="{StaticResource Muted}" /><TextBlock x:Name="LinesText" Text="–" Style="{StaticResource TileValue}" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel><TextBlock Text="Words" Style="{StaticResource Muted}" /><TextBlock x:Name="WordsText" Text="–" Style="{StaticResource TileValue}" /></StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="SummaryNote" Grid.Row="1" Style="{StaticResource Muted}" Margin="0,0,0,6" />

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="By file type">
                            <ListView x:Name="TypeList" AutomationProperties.Name="Files by type">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding Type}" />
                                        <GridViewColumn Header="Files" Width="60" DisplayMemberBinding="{Binding Count}" />
                                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                                        <GridViewColumn Header="Share" Width="60" DisplayMemberBinding="{Binding Share}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Largest files (double-click to show in folder)">
                            <ListView x:Name="LargestList" AutomationProperties.Name="Largest files" MouseDoubleClick="FileList_DoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </Grid>
                    <GroupBox Grid.Row="3" Header="Newest files (double-click to show in folder)">
                        <ListView x:Name="NewestList" AutomationProperties.Name="Newest files" MouseDoubleClick="FileList_DoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="Folder" Width="260" DisplayMemberBinding="{Binding Folder}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="SearchTab" Header="Search">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" MinWidth="80" IsDefault="True" Click="Search_Click" />
                        <CheckBox x:Name="WholeWordsCheck" DockPanel.Dock="Right" Content="Whole words" VerticalAlignment="Center" Margin="8,0,8,0" />
                        <TextBox x:Name="PhraseBox" AutomationProperties.Name="Word or sentence to find" MaxLength="500"
                                 VerticalContentAlignment="Center" Padding="4,2" TextChanged="PhraseBox_TextChanged" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,4,0,6"
                               Text="Finds the whole word or sentence, ignoring case; any spacing between its words matches. Text files and Word (.docx) documents are searched." />
                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="Filter results:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="TypeFilterBox" MinWidth="130" Margin="0,0,8,0" AutomationProperties.Name="Show matches in this file type"
                                  SelectionChanged="TypeFilter_SelectionChanged" />
                        <Button x:Name="ClearFiltersButton" DockPanel.Dock="Right" Content="Clear filters" MinWidth="90" Margin="8,0,0,0"
                                IsEnabled="False" Click="ClearFilters_Click" />
                        <Grid>
                            <TextBox x:Name="ResultFilterBox" AutomationProperties.Name="Show matches whose file name, folder or line contains this text"
                                     MaxLength="200" VerticalContentAlignment="Center" Padding="4,2" TextChanged="ResultFilter_TextChanged" />
                            <TextBlock Text="File name, folder or text contains…" IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ResultFilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <ListView x:Name="ResultList" Grid.Row="3" AutomationProperties.Name="Search results"
                              MouseDoubleClick="ResultList_DoubleClick" SelectionMode="Single"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File" Width="170" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Line" Width="60" DisplayMemberBinding="{Binding LineText}" />
                                <GridViewColumn Header="Text" Width="400">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Hit, Mode=OneWay}" FontWeight="Bold"
                                                     Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                     Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" /><Run Text="{Binding After, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Folder" Width="260" DisplayMemberBinding="{Binding Folder}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="OpenButton" Content="Open file" MinWidth="80" Margin="0,0,8,0" Click="Open_Click" />
                            <Button x:Name="RevealButton" Content="Show in folder" MinWidth="100" Click="Reveal_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SearchStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="72" Margin="8,0,8,0" IsEnabled="False" Click="Cancel_Click" />
                <Button Content="Close" MinWidth="72" Click="Close_Click" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Width="160" Height="12" DockPanel.Dock="Left" Margin="0,0,10,0" Visibility="Hidden" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
