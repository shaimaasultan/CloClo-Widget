            <TextBlock Canvas.Left="130" Canvas.Top="233.4" Text="⏸" FontFamily="Segoe UI Symbol" FontSize="10"
                       Foreground="{StaticResource Face}" Effect="{StaticResource TextShadow}" Opacity="0.8" />
        </Canvas>
    </Canvas>
</UserControl>
