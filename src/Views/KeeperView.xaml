        <!-- Only the time and the date up here, a little larger than the
             other small text, so they read at a glance. -->
        <TextBlock x:Name="DateTimeLine" Style="{StaticResource Label}" Canvas.Left="0" Canvas.Top="-1.5" Width="150"
                   TextAlignment="Center" FontSize="10">
            <Run x:Name="ClockTime" FontWeight="Bold" /><Run Text="  ·  " /><Run x:Name="ClockDate" FontWeight="SemiBold" />
        </TextBlock>
        <!-- The stopwatch, top-left under the battery (its Canvas.Top follows
             what the battery shows - see PlaceStatusColumn), while it has a time. -->
        <TextBlock x:Name="StopwatchLabel" Style="{StaticResource Label}" Canvas.Left="9" Canvas.Top="15"
                   FontSize="9.5" FontWeight="SemiBold" Visibility="Collapsed">
            <Run FontFamily="Segoe UI Emoji" Text="⏱" /><Run x:Name="StopwatchTime" Text=" 0:00" />
        </TextBlock>
        <!-- "Up 3d 4h 12m" since Windows last started, last in the same
             top-left column (see PlaceStatusColumn). Always left-to-right
             with Latin digits, like the battery line beside it. The moon
             shows when that time includes sleep or hibernation; hovering
             it (through the avatar window, see UptimeSleepIconBounds)
             shows the details. -->
        <StackPanel x:Name="UptimeLine" Canvas.Left="9" Canvas.Top="15" Orientation="Horizontal"
                    FlowDirection="LeftToRight" Visibility="Collapsed">
            <TextBlock x:Name="UptimeLabel" Style="{StaticResource Label}" FontSize="8.5" FontWeight="SemiBold" Opacity="0.85" />
            <!-- A glowing gold moon on a small night-sky disc, so it reads on
                 light and dark wallpaper alike (no contrast switching). -->
            <Grid x:Name="UptimeSleepIcon" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Ellipse Fill="#2a2019" Stroke="#8a6a2f" StrokeThickness="0.6">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#ffd36a" ShadowDepth="0" BlurRadius="6" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="8.5" FontWeight="Bold" Foreground="#ffd76e"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"
                           AutomationProperties.Name="Includes sleep time">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#ffe08a" ShadowDepth="0" BlurRadius="4" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </StackPanel>
        <!-- "12° Clear": the sky in words sits with the temperature, like a weather app. -->
        <TextBlock x:Name="Temp" Style="{StaticResource Label}" Canvas.Left="0" Canvas.Top="171.9" Width="150"
                   TextAlignment="Center" FontSize="19" FontWeight="ExtraBold">
            <Run x:Name="TempValue" Text="--°" /><Run x:Name="SkyWord" FontSize="11" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock x:Name="Place" Style="{StaticResource Label}" Canvas.Left="5" Canvas.Top="194" Width="140"
                   TextAlignment="Center" FontSize="10" Opacity="0.9" TextTrimming="CharacterEllipsis" Text="…" />

        <!-- ===== battery, top-left ===== -->
        <Canvas x:Name="Battery" Visibility="Collapsed">
            <Canvas Effect="{StaticResource BatteryShadow}">
                <Border Canvas.Left="8" Canvas.Top="18" Width="15" Height="8" BorderBrush="{StaticResource Face}" BorderThickness="1.2" CornerRadius="2" />
                <Rectangle Canvas.Left="23.3" Canvas.Top="21.2" Width="1.5" Height="3" RadiusX="0.7" RadiusY="0.7" Fill="{StaticResource Face}" />
                <Rectangle x:Name="BatteryFill" Canvas.Left="10.2" Canvas.Top="20.2" Width="2" Height="3.6" RadiusX="1" RadiusY="1" Fill="{StaticResource Face}" />
                <!-- A bolt across the battery while the charger is connected. -->
                <Path x:Name="BatteryPlug" Data="M16.9 18.6 L13.4 22.5 L15.5 22.5 L14.6 25.4 L18.1 21.5 L16 21.5 Z"
                      Fill="{StaticResource Ink}" Stroke="{StaticResource Highlight}" StrokeThickness="0.5" StrokeLineJoin="Round"
                      Visibility="Collapsed" />
            </Canvas>
            <StackPanel x:Name="BatteryLine" Canvas.Left="26" Canvas.Top="15.3" Orientation="Horizontal">
                <TextBlock x:Name="BatteryPercent" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" Text="--%" />
                <TextBlock x:Name="BatteryBolt" Style="{StaticResource Label}" FontFamily="Segoe UI Emoji" FontSize="9" Margin="3,0,0,0"
                           VerticalAlignment="Center" Text="⚡" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="BatteryTime" Style="{StaticResource Label}" Canvas.Left="9" Canvas.Top="30" FontSize="8.5"
                       FontWeight="SemiBold" Opacity="0.85" Visibility="Collapsed" />
        </Canvas>

        <!-- ===== connections, in the top-left column ===== -->
        <!-- The internet connection, then Bluetooth and headphones. Beside
             the battery percentage when they fit, otherwise on a row of
             their own; first in the column without a battery (see
             PlaceStatusColumn). Hovering an icon (through the avatar window,
             see ConnectionIconBounds) shows its details. Drawn, not text,
             so they never mirror. Each is a Label so screen readers find it
             (as text) with its full name. -->
        <StackPanel x:Name="ConnectionsLine" Canvas.Left="9" Canvas.Top="15" Orientation="Horizontal"
                    FlowDirection="LeftToRight">
        <!-- A mains plug in the battery's place on a PC without a battery,
             so the power card (power mode, energy saver) has an icon to
             hover too. -->
        <Label x:Name="AcPowerIcon" Padding="0" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Canvas Width="9" Height="10.5" Effect="{StaticResource BatteryShadow}">
                <Path Data="M3,0.6 V3 M6,0.6 V3" Stroke="{StaticResource Face}" StrokeThickness="1.2" StrokeStartLineCap="Round" />
                <Path Data="M1.3,3 H7.7 V5.2 A3.2,3.2 0 0 1 1.3,5.2 Z" Fill="{StaticResource Face}" />
                <Path Data="M4.5,8 V10.2" Stroke="{StaticResource Face}" StrokeThickness="1.2" StrokeEndLineCap="Round" />
            </Canvas>
        </Label>
        <!-- One glyph for how the PC is connected (wired, Wi-Fi with its
             bars, cellular with its generation, offline, other), then small
             gold badges: "!" without full internet, a globe on a public
             network, a gauge when metered. -->
        <Label x:Name="NetworkLine" Padding="0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
            <Canvas x:Name="NetworkGlyph" Width="12" Height="10.5" VerticalAlignment="Center" Effect="{StaticResource BatteryShadow}">
                <Canvas x:Name="NetWifi">
                    <Ellipse x:Name="NetWifi1" Canvas.Left="4.9" Canvas.Top="8.4" Width="2.2" Height="2.2" Fill="{StaticResource Face}" />
                    <Path x:Name="NetWifi2" Data="M3.53,7.03 A3.5,3.5 0 0 1 8.47,7.03" Stroke="{StaticResource Face}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="NetWifi3" Data="M1.76,5.26 A6,6 0 0 1 10.24,5.26" Stroke="{StaticResource Face}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="NetWifi4" Data="M0.4,3.49 A8.5,8.5 0 0 1 11.6,3.49" Stroke="{StaticResource Face}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <!-- An Ethernet port. -->
                <Canvas x:Name="NetEthernet" Visibility="Collapsed">
                    <Path Data="M1.5,1.2 H10.5 V7.2 H8.3 V9.4 H3.7 V7.2 H1.5 Z" Stroke="{StaticResource Face}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                    <Path Data="M4,2.6 V4.4 M6,2.6 V4.4 M8,2.6 V4.4" Stroke="{StaticResource Face}" StrokeThickness="1" />
                </Canvas>
                <Canvas x:Name="NetCellular" Visibility="Collapsed">
                    <Rectangle x:Name="NetCell1" Canvas.Left="0.5" Canvas.Top="7.5" Width="2" Height="2.5" RadiusX="0.5" RadiusY="0.5" Fill="{StaticResource Face}" />
                    <Rectangle x:Name="NetCell2" Canvas.Left="3.5" Canvas.Top="5.5" Width="2" Height="4.5" RadiusX="0.5" RadiusY="0.5" Fill="{StaticResource Face}" />
                    <Rectangle x:Name="NetCell3" Canvas.Left="6.5" Canvas.Top="3.5" Width="2" Height="6.5" RadiusX="0.5" RadiusY="0.5" Fill="{StaticResource Face}" />
                    <Rectangle x:Name="NetCell4" Canvas.Left="9.5" Canvas.Top="1.5" Width="2" Height="8.5" RadiusX="0.5" RadiusY="0.5" Fill="{StaticResource Face}" />
                </Canvas>
                <!-- A globe: connected some other way (VPN, dial-up...). -->
                <Canvas x:Name="NetOther" Visibility="Collapsed">
                    <Ellipse Canvas.Left="1.5" Canvas.Top="0.75" Width="9" Height="9" Stroke="{StaticResource Face}" StrokeThickness="1.1" />
                    <Ellipse Canvas.Left="4" Canvas.Top="0.75" Width="4" Height="9" Stroke="{StaticResource Face}" StrokeThickness="0.9" />
                    <Line X1="1.8" Y1="5.25" X2="10.2" Y2="5.25" Stroke="{StaticResource Face}" StrokeThickness="0.9" />
                </Canvas>
                <!-- Offline: a cloud struck through in red. -->
                <Canvas x:Name="NetOffline" Visibility="Collapsed">
                    <Path Data="M3,8.5 H9 A2.2,2.2 0 0 0 9.2,4.1 A3,3 0 0 0 3.6,3.6 A2.5,2.5 0 0 0 3,8.5 Z" Stroke="{StaticResource Face}" StrokeThickness="1.1" StrokeLineJoin="Round" />
                    <Line X1="1.5" Y1="1.2" X2="10.5" Y2="10" Stroke="#e2665c" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Canvas>
            <TextBlock x:Name="NetworkGeneration" Style="{StaticResource Label}" FontSize="7.5" FontWeight="Bold" Margin="1.5,0,0,0"
                       VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="NetLimitedBadge" Text="!" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Black" Foreground="{StaticResource Highlight}"
                       Margin="1.5,0,0,0" VerticalAlignment="Center" Effect="{StaticResource BatteryShadow}" Visibility="Collapsed" />
            <Canvas x:Name="NetPublicBadge" Width="7" Height="7" Margin="2,0,0,0" VerticalAlignment="Center" Effect="{StaticResource BatteryShadow}" Visibility="Collapsed">
                <Ellipse Canvas.Left="0.5" Canvas.Top="0.5" Width="6" Height="6" Stroke="{StaticResource Highlight}" StrokeThickness="0.9" />
                <Ellipse Canvas.Left="2.2" Canvas.Top="0.5" Width="2.6" Height="6" Stroke="{StaticResource Highlight}" StrokeThickness="0.7" />
                <Line X1="0.7" Y1="3.5" X2="6.3" Y2="3.5" Stroke="{StaticResource Highlight}" StrokeThickness="0.7" />
            </Canvas>
            <Canvas x:Name="NetMeteredBadge" Width="8" Height="6" Margin="2,0,0,0" VerticalAlignment="Center" Effect="{StaticResource BatteryShadow}" Visibility="Collapsed">
                <Path Data="M0.7,5.4 A3.3,3.3 0 0 1 7.3,5.4" Stroke="{StaticResource Highlight}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M4,5.4 L6,2.6" Stroke="{StaticResource Highlight}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </StackPanel>
        </Label>
        <!-- The Bluetooth rune while the radio is on: bright with a device
             connected, faint with none. Hidden while it's off. -->
        <Label x:Name="BluetoothIcon" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Canvas Width="7" Height="10.5" Effect="{StaticResource BatteryShadow}">
                <Path x:Name="BluetoothRune" Data="M0.9,3 L5.8,7.4 L3.4,9.7 V0.8 L5.8,3.1 L0.9,7.5" Stroke="{StaticResource Face}"
                      StrokeThickness="1.15" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Label>
        <!-- Headphones while the default playback device is headphones or a
             headset (with a microphone boom). -->
        <Label x:Name="HeadphonesIcon" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Canvas Width="11" Height="10.5" Effect="{StaticResource BatteryShadow}">
                <Path Data="M1.6,7 V5.6 A3.9,3.9 0 0 1 9.4,5.6 V7" Stroke="{StaticResource Face}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Rectangle Canvas.Left="0.6" Canvas.Top="5.9" Width="2.6" Height="3.9" RadiusX="1" RadiusY="1" Fill="{StaticResource Face}" />
                <Rectangle Canvas.Left="7.8" Canvas.Top="5.9" Width="2.6" Height="3.9" RadiusX="1" RadiusY="1" Fill="{StaticResource Face}" />
                <Path x:Name="HeadsetBoom" Data="M1.9,9.6 Q2.6,10.6 5,10.3" Stroke="{StaticResource Face}" StrokeThickness="0.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
            </Canvas>
        </Label>
        </StackPanel>

        <!-- ===== icon bar — must stay in sync with ComputeIconRects ===== -->
        <Grid Canvas.Left="10" Canvas.Top="208" Width="140" Height="20">
        <StackPanel x:Name="MediaBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="IconYoutube" Style="{StaticResource MediaIcon}">
                <Rectangle RadiusX="5" RadiusY="5" Fill="#ff0033" Effect="{StaticResource IconShadow}" />
                <Path Data="M6.75,5 L12.75,9 L6.75,13 Z" Fill="White" />
            </Grid>
            <Grid x:Name="IconSpotify" Style="{StaticResource MediaIcon}">
                <Ellipse Fill="#1db954" Effect="{StaticResource IconShadow}" />
                <TextBlock Text="♪" FontFamily="Segoe UI Symbol" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="IconBell" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="13" Text="🔔" /></Grid>
            <Grid x:Name="IconSearch" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="13" Text="🔍" /></Grid>
            <Grid x:Name="IconGpu" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="🖥️" /></Grid>
            <Grid x:Name="IconRead" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="🗣️" /></Grid>
            <Grid x:Name="IconDetails" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="📊" /></Grid>
            <Grid x:Name="IconMic" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="🎤" /></Grid>
            <Grid x:Name="IconConvert" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="💱" /></Grid>
            <Grid x:Name="IconColor" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="🎨" /></Grid>
            <Grid x:Name="IconQr" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="📱" /></Grid>
            <Grid x:Name="IconVolume" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="🔊" /></Grid>
            <Grid x:Name="IconClipboard" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="📋" /></Grid>
            <Grid x:Name="IconStopwatch" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="⏱️" /></Grid>
            <Grid x:Name="IconDaily" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="💡" /></Grid>
            <Grid x:Name="IconSudoku" Style="{StaticResource MediaIcon}"><TextBlock Style="{StaticResource IconGlyph}" FontSize="12" Text="🔢" /></Grid>
        </StackPanel>
        </Grid>

        <!-- ===== now playing / latest notification label — PauseIconRect,
             ListIconRect and LabelBodyRect must stay in sync with this ===== -->
        <Canvas x:Name="NowPlaying" Visibility="Collapsed">
            <Rectangle Canvas.Left="3" Canvas.Top="230" Width="144" Height="36" RadiusX="9" RadiusY="9" Fill="#66000000" />
                <TextBlock x:Name="NowPlayingNote" Canvas.Left="9" Canvas.Top="235" Text="♪" FontFamily="Segoe UI Symbol" FontSize="10"
                       Foreground="{StaticResource Face}" Effect="{StaticResource TextShadow}" Opacity="0.85" />
            <Image x:Name="NowPlayingIcon" Canvas.Left="9" Canvas.Top="235" Width="15" Height="15" Stretch="UniformToFill" Visibility="Collapsed">
                <Image.Clip><RectangleGeometry Rect="0,0,15,15" RadiusX="3" RadiusY="3" /></Image.Clip>
            </Image>
            <Canvas x:Name="TitleLine" Canvas.Left="18" Canvas.Top="234" Width="97" Height="13.75" ClipToBounds="True">
                <Canvas.OpacityMask>
                    <LinearGradientBrush x:Name="TitleMask" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.062" Color="Black" />
                        <GradientStop Offset="0.938" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>
                <TextBlock x:Name="NowPlayingTitle" Canvas.Top="-0.45" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Face}" Effect="{StaticResource TextShadow}">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
            <Canvas x:Name="SubtitleLine" Canvas.Left="18" Canvas.Top="250.75" Width="97" Height="11.9" ClipToBounds="True">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.062" Color="Black" />
                        <GradientStop Offset="0.938" Color="Black" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>
                <TextBlock x:Name="NowPlayingSubtitle" Canvas.Top="-0.38" FontFamily="Segoe UI" FontSize="9.5"
                           Foreground="{StaticResource Face}" Effect="{StaticResource TextShadow}" Opacity="0.8">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
            <TextBlock x:Name="ListButton" Canvas.Left="115" Canvas.Top="233.5" Text="☰" FontFamily="Segoe UI Symbol" FontSize="9"
                       Foreground="{StaticResource Face}" Effect="{StaticResource TextShadow}" Opacity="0.8" Visibility="Collapsed" />
            <TextBlock Canvas.Left="130" Canvas.Top="233.4" Text="⏸" FontFamily="Segoe UI Symbol" FontSize="10"
                       Foreground="{StaticResource Face}" Effect="{StaticResource TextShadow}" Opacity="0.8" />
        </Canvas>
    </Canvas>
</UserControl>
