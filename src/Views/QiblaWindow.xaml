<Window x:Class="CloCloWidget.QiblaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Qibla direction" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <StackPanel Margin="18">
        <TextBlock x:Name="LocationText" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
        <!-- Two compasses side by side: the shortest route over the globe
             (great circle) and the straight line on a flat map (rhumb line).
             Built in code; they turn with a compass sensor when there is one,
             otherwise North stays up. -->
        <Grid Margin="0,14,0,0" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="On the globe (shortest route)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ContentControl x:Name="GlobeCompassHost" Margin="0,8,0,8" Focusable="False" />
                <TextBlock x:Name="BearingText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Used by most mosques and Qibla apps" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="On a flat map (straight line)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ContentControl x:Name="FlatCompassHost" Margin="0,8,0,8" Focusable="False" />
                <TextBlock x:Name="FlatBearingText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="One fixed heading; a longer route" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ArabicText" FontSize="15" TextWrapping="Wrap" Margin="0,12,0,0"
                   FlowDirection="RightToLeft" TextAlignment="Left" Language="ar"
                   FontFamily="Segoe UI, Arial" Visibility="Collapsed" />
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock x:Name="SensorText" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        <!-- Without a compass sensor: the user says once which way the screen
             faces, and/or lines up with the sun. Both are saved. -->
        <CheckBox x:Name="MatchScreenBox" Content="Turn the compasses to match the way my screen faces"
                  Margin="0,14,0,0" Checked="Options_Changed" Unchecked="Options_Changed" />
        <StackPanel x:Name="ScreenHeadingPanel" Margin="22,6,0,0">
            <DockPanel>
                <TextBlock x:Name="ScreenHeadingValue" DockPanel.Dock="Right" Width="70" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <Slider x:Name="ScreenHeadingSlider" Minimum="0" Maximum="359" SmallChange="1" LargeChange="15"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        AutomationProperties.Name="Direction I face when looking at my screen, in degrees from north"
                        ValueChanged="ScreenHeading_Changed" />
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="Sit facing the screen, hold your phone flat pointing the same way, and set the degrees its compass shows. Arrow keys change it by 1°, Page Up and Page Down by 15°." />
        </StackPanel>
        <CheckBox x:Name="SunGuideBox" Content="Show the sun as a guide" Margin="0,10,0,0"
                  Checked="Options_Changed" Unchecked="Options_Changed" />
        <TextBlock x:Name="SunText" TextWrapping="Wrap" Margin="22,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ReadAloudButton" Content="Read aloud" MinWidth="85" Margin="0,0,8,0"
                    Click="ReadAloud_Click" />
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="75" />
        </StackPanel>
    </StackPanel>
</Window>
