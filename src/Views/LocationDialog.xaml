<Window x:Class="CloCloWidget.LocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Set location"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#241a10">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#c9a24b" />
            <Setter Property="Foreground" Value="#241e1a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#1e1610" />
            <Setter Property="Foreground" Value="#f3ecdd" />
            <Setter Property="BorderBrush" Value="#8a6a2f" />
            <Setter Property="CaretBrush" Value="#f3ecdd" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="City name" Foreground="#f3ecdd" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBox x:Name="CityBox" KeyDown="CityBox_KeyDown" />
        <Button x:Name="UseLocationButton" Content="📍 Use my location" Click="UseLocation_Click"
                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5"
                Background="#3c2f1a" Foreground="#f3ecdd" FontWeight="Normal" />
        <TextBlock x:Name="StatusText" Foreground="#c9a24b" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Background="#3c1512" Foreground="#f3ecdd" />
            <Button x:Name="OkButton" Content="Save" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
