<Window x:Class="CloCloWidget.CustomRemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom reminders" Width="440" Height="440"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Create up to five local reminders. Active hours use your PC’s local time."
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <ListBox x:Name="ReminderList" Grid.Row="1" DisplayMemberPath="Message"
                 SelectionChanged="ReminderList_SelectionChanged" />
        <TextBlock x:Name="ReminderDetails" Grid.Row="2" Margin="2,8,2,10"
                   TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="AddButton" Content="Add…" MinWidth="64" Margin="0,0,6,0" Click="AddButton_Click" />
                <Button x:Name="EditButton" Content="Edit…" MinWidth="64" Margin="0,0,6,0" Click="EditButton_Click" IsEnabled="False" />
                <Button x:Name="ToggleButton" Content="Enable/disable" MinWidth="100" Margin="0,0,6,0" Click="ToggleButton_Click" IsEnabled="False" />
                <Button x:Name="RemoveButton" Content="Remove" MinWidth="64" Click="RemoveButton_Click" IsEnabled="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" MinWidth="64" Margin="0,0,6,0" IsCancel="True" />
                <Button Content="Save reminders" MinWidth="104" IsDefault="True" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
