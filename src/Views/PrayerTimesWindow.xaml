<Window x:Class="CloCloWidget.PrayerTimesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Prayer times" Width="450" Height="525"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="LocationText" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
        <TextBlock x:Name="TimeZoneText" Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Calculation" VerticalAlignment="Center" Width="110" />
            <ComboBox x:Name="MethodBox" Width="275" SelectionChanged="Settings_Changed">
                <ComboBoxItem Content="North America (ISNA)" Tag="isna" />
                <ComboBoxItem Content="Muslim World League" Tag="mwl" />
                <ComboBoxItem Content="Egyptian General Authority" Tag="egyptian" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Asr convention" VerticalAlignment="Center" Width="110" />
            <ComboBox x:Name="AsrBox" Width="275" SelectionChanged="Settings_Changed">
                <ComboBoxItem Content="Standard" Tag="standard" />
                <ComboBoxItem Content="Hanafi" Tag="hanafi" />
            </ComboBox>
        </StackPanel>
        <Border Grid.Row="4" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ScheduleHeading" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock x:Name="TimesText" FontSize="15" LineHeight="29" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="5">
            <CheckBox x:Name="EnableAzanBox" Content="Play azan automatically at prayer times"
                      Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,6">
                <Button Content="Choose audio…" Click="ChooseAudio_Click" DockPanel.Dock="Left" Padding="10,5" />
                <Button Content="Preview" Click="Preview_Click" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" />
                <TextBlock x:Name="AudioFileText" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="75" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" MinWidth="75" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
