<Window x:Class="CloCloWidget.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — QR Code"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#241a10">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#c9a24b" />
            <Setter Property="Foreground" Value="#241e1a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#1e1610" />
            <Setter Property="Foreground" Value="#f3ecdd" />
            <Setter Property="BorderBrush" Value="#8a6a2f" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- A plain white card, not the window's own dark background —
             a QR scanner needs real contrast and a light "quiet zone"
             around the code, which the PNG QRCoder renders already
             includes, but the extra padding here gives it a bit more
             breathing room against the surrounding chrome. -->
        <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Image x:Name="QrImage" Width="220" Height="220"
                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
        <TextBox x:Name="SourceTextBox" MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyButton" Grid.Column="0" Content="Copy text" Click="Copy_Click" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" Background="#3c1512" Foreground="#f3ecdd" />
        </Grid>
    </StackPanel>
</Window>
