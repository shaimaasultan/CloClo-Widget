<Window x:Class="CloCloWidget.VoiceConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Voice converter"
        Width="900" Height="860" MinWidth="640" MinHeight="680"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="#1C2935" Foreground="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34495B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#526779" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Background" Value="#14202A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#526779" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="LaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="LaneInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9FB3C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="Lane" TargetType="Border">
            <Setter Property="Background" Value="#101921" />
            <Setter Property="BorderBrush" Value="#34495B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The two words -->
        <WrapPanel Grid.Row="0">
            <TextBlock Text="Word I said:" Foreground="#D6E2EC" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SaidBox" Style="{StaticResource Field}" Text="cloclo" Margin="0,0,20,0" />
            <TextBlock Text="Other word:" Foreground="#D6E2EC" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="OtherBox" Style="{StaticResource Field}" Text="youtube" Margin="0,0,12,0" />
            <Button x:Name="SwapButton" Content="⇄ Swap" Click="Swap_Click" ToolTip="Swap the two words" />
        </WrapPanel>

        <!-- Converter settings -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" Background="#22384A" BorderBrush="#3F6A8A" BorderThickness="1" CornerRadius="4">
            <WrapPanel>
                <TextBlock Text="David's pitch" Foreground="#D6E2EC" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="PitchSlider" Width="120" Minimum="60" Maximum="160" Value="84" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="Pitch_Changed" />
                <TextBlock x:Name="PitchText" Foreground="#D6E2EC" VerticalAlignment="Center" Width="52" Margin="6,0,10,0" Text="84 Hz" />
                <CheckBox x:Name="IntonationCheck" Content="follow my intonation" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                <TextBlock Text="mouth size" Foreground="#D6E2EC" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="MouthBox" SelectedIndex="0" VerticalAlignment="Center" Margin="0,0,14,0" SelectionChanged="MouthBox_Changed">
                    <ComboBoxItem Content="as mine" Tag="1" />
                    <ComboBoxItem Content="male (−15%)" Tag="0.85" />
                    <ComboBoxItem Content="fit to David's voice" Tag="voice" />
                </ComboBox>
                <CheckBox x:Name="ColourCheck" Content="David's colour" Checked="Option_Changed" Unchecked="Option_Changed"
                          ToolTip="His average tone, from both of his words, in place of yours" />
                <CheckBox x:Name="SameScaleCheck" Content="same time scale" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"
                          ToolTip="On: real lengths, the longest fills the width. Off: each signal stretched across the full width." />
            </WrapPanel>
        </Border>

        <!-- Record -->
        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="RecordButton" Content="● Record me" Click="Record_Click" Background="#8A3B3B" FontSize="15" Padding="16,7" />
            <TextBlock x:Name="RecordStatus" Foreground="#D6E2EC" VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="Wrap" MaxWidth="560"
                       Text="Record yourself saying the word in “Word I said”." />
        </WrapPanel>

        <!-- 1. My voice -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource LaneTitle}" Text="1 · My voice" Foreground="#7FB8E0" />
            <Button x:Name="PlayMeButton" Content="▶ Play" Click="PlayMe_Click" IsEnabled="False" Padding="10,2" />
            <TextBlock x:Name="MeInfo" Style="{StaticResource LaneInfo}" />
        </StackPanel>
        <Border Grid.Row="4" Style="{StaticResource Lane}"><Canvas x:Name="MeCanvas" ClipToBounds="True" /></Border>

        <!-- 2. My voice converted to David -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource LaneTitle}" Text="2 · My voice → David" Foreground="#7FD18B" />
            <Button x:Name="PlayConvertedButton" Content="▶ Play" Click="PlayConverted_Click" IsEnabled="False" Padding="10,2" />
            <TextBlock x:Name="ConvertedInfo" Style="{StaticResource LaneInfo}" />
        </StackPanel>
        <Border Grid.Row="6" Style="{StaticResource Lane}"><Canvas x:Name="ConvertedCanvas" ClipToBounds="True" /></Border>

        <!-- 3. David, the word I said -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="SaidTitle" Style="{StaticResource LaneTitle}" Text="3 · David: word I said" Foreground="#E8A75A" />
            <Button x:Name="PlaySaidButton" Content="▶ Play" Click="PlaySaid_Click" IsEnabled="False" Padding="10,2" />
            <TextBlock x:Name="SaidInfo" Style="{StaticResource LaneInfo}" />
        </StackPanel>
        <Border Grid.Row="8" Style="{StaticResource Lane}"><Canvas x:Name="SaidCanvas" ClipToBounds="True" /></Border>

        <!-- 4. David, the other word -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="OtherTitle" Style="{StaticResource LaneTitle}" Text="4 · David: other word" Foreground="#C98BE0" />
            <Button x:Name="PlayOtherButton" Content="▶ Play" Click="PlayOther_Click" IsEnabled="False" Padding="10,2" />
            <TextBlock x:Name="OtherInfo" Style="{StaticResource LaneInfo}" />
        </StackPanel>
        <Border Grid.Row="10" Style="{StaticResource Lane}"><Canvas x:Name="OtherCanvas" ClipToBounds="True" /></Border>

        <TextBlock x:Name="ScoreText" Grid.Row="11" Margin="0,10,0,0" FontSize="13" Foreground="White" TextWrapping="Wrap" />
    </Grid>
</Window>
