<Window x:Class="CloCloWidget.SoundPatternTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Sound letters test"
        Width="760" Height="1000" MinWidth="660" MinHeight="800"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="#1C2935" Foreground="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34495B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#526779" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Default header chrome is light; keep its text dark to stay readable. -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="#1C2935" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="#14202A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#526779" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB3C4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <DataTemplate x:Key="FingerprintTemplate">
            <ItemsControl ItemsSource="{Binding Bars}" Height="24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="9" Margin="0,0,1,0" Height="{Binding}" VerticalAlignment="Bottom" Fill="#7FB8E0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock TextWrapping="Wrap" Foreground="#D6E2EC"
                       Text="Say a word, then pause. CloClo writes the letters it heard, measured with plain signal math (no models). Teach it letters said alone, and it uses them to read words better." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Style="{StaticResource Chip}" Background="#3FA37A"><TextBlock Text="vowel" /></Border>
                <Border Style="{StaticResource Chip}" Background="#4A7FB5"><TextBlock Text="consonant" /></Border>
                <Border Style="{StaticResource Chip}" Background="#3A4A58"><TextBlock Text="_ pause" /></Border>
                <TextBlock VerticalAlignment="Center" Foreground="#9FB3C4" FontSize="12" TextWrapping="Wrap" MaxWidth="460"
                           Text="Underlined = from your taught letters, italic = from Windows Hoda, plain = guess by rules." />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource Caption}" Text="Live microphone (last 3 seconds)" />
            <Border Background="#14202A" BorderBrush="#34495B" BorderThickness="1" Height="56">
                <Canvas x:Name="LiveCanvas" ClipToBounds="True" />
            </Border>
            <TextBlock x:Name="StatusText" Foreground="#9FB3C4" FontSize="12" Margin="0,4,0,0" Text="Starting the microphone…" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Ignore room sounds:" VerticalAlignment="Center" Foreground="#D6E2EC" Margin="0,0,8,0" />
                <TextBlock DockPanel.Dock="Right" x:Name="SensitivityText" VerticalAlignment="Center" Foreground="#9FB3C4" Width="240" Margin="8,0,0,0" />
                <Slider x:Name="SensitivitySlider" Minimum="8" Maximum="30" Value="15" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ToolTip="Move right if the fan, keyboard or TV is picked up as words" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="#22384A" BorderBrush="#3F6A8A" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="TeachCheck" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"
                              Content="Teach one letter:" Checked="TeachCheck_Changed" Unchecked="TeachCheck_Changed" />
                    <TextBox x:Name="TeachBox" Style="{StaticResource Field}" Width="50" MaxLength="3" Margin="8,0,0,0"
                             FontFamily="Consolas" FontSize="16" HorizontalContentAlignment="Center" TextChanged="TeachBox_TextChanged" />
                    <TextBlock x:Name="TeachStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#D6E2EC" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Foreground="#9FB3C4" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Type a letter, tick the box, then say just that sound several times with a pause between: “sss”, “mmm”, “ooo”, “k”. Each one is saved under the letter. Have different people teach the same letters." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Style="{StaticResource Caption}" Text="Last sound" />
            <Border Background="#14202A" BorderBrush="#34495B" BorderThickness="1" Height="44">
                <Canvas x:Name="WordCanvas" ClipToBounds="True" />
            </Border>
            <TextBlock x:Name="PatternText" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" Text="—" />
            <TextBlock x:Name="DetailText" Foreground="#9FB3C4" FontSize="12" TextWrapping="Wrap" />
            <Border Margin="0,8,0,0" Padding="10,8" Background="#14202A" BorderBrush="#34495B" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="WaveModeRadio" Content="Wave (signal only)" GroupName="CompareMode" IsChecked="True"
                                 Foreground="White" Margin="0,0,16,0" Checked="CompareMode_Changed" />
                    <RadioButton x:Name="BandsModeRadio" Content="Bands vs Hoda" GroupName="CompareMode"
                                 Foreground="White" Checked="CompareMode_Changed" />
                </StackPanel>
                <Grid x:Name="WavePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="WaveTitle" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" Text="—" />
                        <TextBlock x:Name="WaveScore" FontSize="12" Foreground="#D6E2EC" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="#9FB3C4" FontSize="11" Text="One cycle, stretched to the same length" />
                        <Canvas x:Name="CycleCanvas" Height="60" ClipToBounds="True" Background="#101921" />
                        <TextBlock Foreground="#9FB3C4" FontSize="11" Margin="0,4,0,0" Text="First 4 ms after each pulse (real time, not stretched)" />
                        <Canvas x:Name="RingCanvas" Height="44" ClipToBounds="True" Background="#101921" />
                        <TextBlock Foreground="#9FB3C4" FontSize="11" Margin="0,4,0,0" Text="The signal itself, three cycles each" />
                        <Canvas x:Name="SignalCanvas" Height="56" ClipToBounds="True" Background="#101921" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource Chip}" Background="#8A99A6"><TextBlock Text="sine wave" Foreground="#1C2935" /></Border>
                            <Border Style="{StaticResource Chip}" Background="#E8A75A"><TextBlock Text="Windows David" Foreground="#1C2935" /></Border>
                            <Border Style="{StaticResource Chip}" Background="#7FB8E0"><TextBlock Text="You" Foreground="#1C2935" /></Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="HearDavidButton" Content="▶ Hear David" VerticalAlignment="Top" Margin="10,0,0,0"
                            Click="HearDavid_Click" IsEnabled="False" />
                </Grid>
                <Grid x:Name="BandsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="CompareTitle" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" Text="—" />
                        <TextBlock x:Name="CompareScore" FontSize="13" Foreground="#D6E2EC" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Canvas x:Name="CompareCanvas" Height="56" ClipToBounds="True" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource Chip}" Background="#7FB8E0"><TextBlock x:Name="MineLegend" Text="You" Foreground="#1C2935" /></Border>
                            <Border Style="{StaticResource Chip}" Background="#E8A75A"><TextBlock x:Name="HodaLegend" Text="Windows Hoda" Foreground="#1C2935" /></Border>
                            <TextBlock Foreground="#9FB3C4" FontSize="11" VerticalAlignment="Center" Text="8 bands, low → high pitch" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="HearHodaButton" Content="▶ Hear Hoda" VerticalAlignment="Center" Margin="10,0,0,0"
                            Click="HearHoda_Click" IsEnabled="False" />
                </Grid>
                </StackPanel>
            </Border>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speaker:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#D6E2EC" />
                <TextBox x:Name="SpeakerBox" Grid.Column="1" Style="{StaticResource Field}" ToolTip="Who is speaking, e.g. Sara" />
                <TextBlock Grid.Column="2" Text="Word:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#D6E2EC" />
                <TextBox x:Name="WordBox" Grid.Column="3" Style="{StaticResource Field}" ToolTip="The word being said, e.g. cloclo" />
            </Grid>
        </StackPanel>

        <TabControl Grid.Row="4" Margin="0,10,0,0" Background="#1C2935" BorderBrush="#34495B">
            <TabItem Header="History">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" x:Name="ReferenceText" Style="{StaticResource Caption}" Margin="0,0,0,4"
                               Text="Pick a row and use it as reference to see how close each word's letters are" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Use as reference" Click="UseAsReference_Click" />
                        <Button Content="Copy history" Click="Copy_Click" />
                        <Button Content="Clear" Click="Clear_Click" />
                    </StackPanel>
                    <ListView x:Name="HistoryList" Background="#14202A" Foreground="White" BorderBrush="#34495B">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Speaker" Width="90" DisplayMemberBinding="{Binding Speaker}" />
                                <GridViewColumn Header="Word" Width="90" DisplayMemberBinding="{Binding Word}" />
                                <GridViewColumn Header="Letters" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Syll." Width="40" DisplayMemberBinding="{Binding Syllables}" />
                                <GridViewColumn Header="Match" Width="55" DisplayMemberBinding="{Binding Match}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Letters of last word">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="Each sound on its own. Correct the letter if it's wrong, then save to teach it. Fingerprint = the sound's shape in 8 frequency bands, low to high, with loudness removed." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save these letters" Click="SaveSounds_Click" />
                        <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Foreground="#9FB3C4" />
                    </StackPanel>
                    <ListView x:Name="PiecesList" Background="#14202A" Foreground="White" BorderBrush="#34495B">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="28" DisplayMemberBinding="{Binding Position}" />
                                <GridViewColumn Header="Letter" Width="64">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Letter, UpdateSourceTrigger=PropertyChanged}" Width="44" MaxLength="3"
                                                     FontFamily="Consolas" FontWeight="Bold" HorizontalContentAlignment="Center"
                                                     Background="{Binding Brush}" Foreground="White" BorderBrush="#526779" CaretBrush="White" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ms" Width="45" DisplayMemberBinding="{Binding DurationMs}" />
                                <GridViewColumn Header="Quieter" Width="60" DisplayMemberBinding="{Binding Quieter}" />
                                <GridViewColumn Header="F1 / F2" Width="85" DisplayMemberBinding="{Binding Formants}" />
                                <GridViewColumn Header="Fingerprint" Width="96" CellTemplate="{StaticResource FingerprintTemplate}" />
                                <GridViewColumn Header="vs Hoda" Width="70" DisplayMemberBinding="{Binding VersusHoda}" />
                                <GridViewColumn Header="Closest taught" Width="100" DisplayMemberBinding="{Binding Closest}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Taught letters">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" x:Name="LibraryText" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open folder" Click="OpenFolder_Click" />
                        <Button Content="Delete all taught letters…" Click="DeleteSaved_Click" />
                    </StackPanel>
                    <ListView x:Name="LibraryList" Background="#14202A" Foreground="White" BorderBrush="#34495B">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Letter" Width="55" DisplayMemberBinding="{Binding Letter}" />
                                <GridViewColumn Header="Saved" Width="50" DisplayMemberBinding="{Binding Count}" />
                                <GridViewColumn Header="Speakers" Width="65" DisplayMemberBinding="{Binding Speakers}" />
                                <GridViewColumn Header="ms" Width="50" DisplayMemberBinding="{Binding DurationMs}" />
                                <GridViewColumn Header="Average fingerprint" Width="130" CellTemplate="{StaticResource FingerprintTemplate}" />
                                <GridViewColumn Header="vs Hoda" Width="70" DisplayMemberBinding="{Binding VersusHoda}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
