<Window x:Class="CloCloWidget.DictationCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Speech and dictation"
        Width="540" Height="485"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        MinWidth="490" MinHeight="410"
        Background="#241a10">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#c9a24b" />
            <Setter Property="Foreground" Value="#241e1a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#4c4233" />
            <Setter Property="Foreground" Value="#f3ecdd" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#36825a" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LangButton" TargetType="Button">
            <Setter Property="Background" Value="#3c2f1a" />
            <Setter Property="Foreground" Value="#f3ecdd" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ToggleButton x:Name="MicToggle" Content="Dictate: Off"
                          ToolTip="Captures the default microphone while on and transcribes locally with CloClo's bundled Whisper model. Saves only when you choose Save."
                          Click="MicToggle_Click" />
            <ToggleButton x:Name="ReadToggle" Content="Read aloud: Off" Click="ReadToggle_Click" />
            <ToggleButton x:Name="PlaybackToggle" Content="Transcribe playing audio: Off"
                          ToolTip="Transcribes audio playing on this PC while on: only the browser when Browser audio only is checked, otherwise everything on the default output device. Uses CloClo's bundled local speech model. Saves only when you choose Save."
                          Click="PlaybackToggle_Click" />
        </WrapPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Dictation language:" Foreground="#f3ecdd" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="EnglishButton" Content="EN" Style="{StaticResource LangButton}" Click="English_Click" />
            <Button x:Name="ArabicButton" Content="AR" Style="{StaticResource LangButton}" Click="Arabic_Click" />
        </StackPanel>
        <CheckBox x:Name="ReduceNoiseToggle" Grid.Row="2" Content="Reduce microphone background noise"
                  Foreground="#f3ecdd" Margin="0,0,0,10" Click="ReduceNoiseToggle_Click"
                  ToolTip="Optional local filter for low rumble and quiet gaps. It cannot remove overlapping speech or TV; turn it off if words sound worse." />
        <CheckBox x:Name="HighResolutionMicToggle" Grid.Row="3" Content="Capture mic at 24-bit / 48 kHz (compare)"
                  Foreground="#f3ecdd" Margin="0,0,0,10" Click="HighResolutionMicToggle_Click"
                  ToolTip="Requests 24-bit, 48 kHz mono capture, then resamples locally to Whisper's 16 kHz input. Applies when dictation next starts." />
        <CheckBox x:Name="BrowserOnlyToggle" Grid.Row="4" Content="Browser audio only (ignore notification sounds and other apps)"
                  IsChecked="True" Foreground="#f3ecdd" Margin="0,0,0,10" Click="BrowserOnlyToggle_Click"
                  ToolTip="Transcribe playing audio captures only the web browser playing sound (Edge, Chrome, Firefox, Brave, Opera, or Vivaldi), using Windows' per-app capture. Turn off to capture everything on the default output device." />
        <TextBlock x:Name="Instructions" Grid.Row="5" Foreground="#f3ecdd" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Type or load text, then turn on Read aloud. Dictate transcribes the default microphone locally; Transcribe playing audio listens to the default speaker output." />
        <TextBox x:Name="CaptureBox" Grid.Row="6" Padding="8" Background="#1e1610" Foreground="#f3ecdd"
                 BorderBrush="#8a6a2f" CaretBrush="#f3ecdd" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MaxLength="262144" />
        <!-- Live preview of the phrase being spoken; final text goes into the box above. -->
        <TextBlock x:Name="LiveText" Grid.Row="7" Foreground="#b8a98a" FontStyle="Italic"
                   TextWrapping="Wrap" Margin="2,8,2,0" Visibility="Collapsed"
                   ToolTip="What CloClo is hearing right now. When you pause, the final text replaces it in the box above." />
        <WrapPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Load text file" Click="Load_Click" />
            <Button Content="Save to dictation file" Click="Save_Click" />
            <Button Content="Open folder" Click="OpenFolder_Click" ToolTip="Open the CloClo dictation folder in Explorer" />
            <Button Content="Close" Click="Close_Click" Background="#3c1512" Foreground="#f3ecdd" />
        </WrapPanel>
    </Grid>
</Window>
