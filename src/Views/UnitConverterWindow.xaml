<Window x:Class="CloCloWidget.UnitConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Convert"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#241a10">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#c9a24b" />
            <Setter Property="Foreground" Value="#241e1a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#1e1610" />
            <Setter Property="Foreground" Value="#f3ecdd" />
            <Setter Property="BorderBrush" Value="#8a6a2f" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Black, not the cream used everywhere else — the dropdown
             popup's list items render on their own default light
             background regardless of the Background setter above (a known
             WPF ComboBox chrome quirk), so light text there is unreadable
             even though the closed selection box (which does pick up
             Background correctly) would have been fine with either. -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#1e1610" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <!-- Keyed, not an implicit TargetType="TextBlock" style — an
             implicit one applies to every TextBlock in the window,
             including ones auto-generated inside other controls' own
             default templates (e.g. the ComboBoxItem's own content
             TextBlock), silently overriding their correct inherited
             Foreground. Confirmed this was exactly what broke the
             dropdown's black text: the ComboBoxItem itself correctly had
             Foreground=Black, but its inner TextBlock still showed the
             cream color from this style. -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f3ecdd" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="Number" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox x:Name="ValueBox" Margin="0,0,0,12" />

        <TextBlock Text="From" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox x:Name="FromCombo" Margin="0,0,0,12" />

        <TextBlock Text="To" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox x:Name="ToCombo" Margin="0,0,0,14" />

        <TextBlock Text="Result" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ResultBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0" />
            <Button x:Name="CopyButton" Grid.Column="1" Content="Copy" Click="Copy_Click" />
        </Grid>

        <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right"
                Background="#3c1512" Foreground="#f3ecdd" />
    </StackPanel>
</Window>
