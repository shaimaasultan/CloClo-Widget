<Window x:Class="CloCloWidget.DailyBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Today"
        Width="296" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal">
    <!--
      A speech bubble beside the avatar: today's quote, Arabic word, joke and
      "did you know" fact (DailyContent.cs). Click the bubble for the next
      one, × or Esc to close; ← and → step through them too.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#2a2019" />
        <SolidColorBrush x:Key="Edge" Color="#8a6a2f" />
        <SolidColorBrush x:Key="Text" Color="#f3ecdd" />
        <SolidColorBrush x:Key="Muted" Color="#cbbfa8" />
        <SolidColorBrush x:Key="Accent" Color="#e6c476" />
    </Window.Resources>
    <Grid Margin="4,4,4,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
        </Grid.ColumnDefinitions>

        <!-- The tail, on whichever side the avatar is (see PlaceBeside). -->
        <Path x:Name="TailLeft" Grid.Column="0" Margin="0,26,-1.5,0" VerticalAlignment="Top" HorizontalAlignment="Right"
              Data="M12 0 L0 9 L12 18" Fill="{StaticResource Card}" Stroke="{StaticResource Edge}" StrokeThickness="1.2"
              StrokeLineJoin="Round" Visibility="Collapsed" Panel.ZIndex="1" />
        <Path x:Name="TailRight" Grid.Column="2" Margin="-1.5,26,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
              Data="M0 0 L12 9 L0 18" Fill="{StaticResource Card}" Stroke="{StaticResource Edge}" StrokeThickness="1.2"
              StrokeLineJoin="Round" Panel.ZIndex="1" />

        <Border x:Name="CardBorder" Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1.2" CornerRadius="12" Padding="14,10,14,10" Cursor="Hand"
                MouseLeftButtonUp="Card_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="Heading" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border x:Name="CloseButton" HorizontalAlignment="Right" Width="24" Height="24" CornerRadius="12"
                            Background="Transparent" Cursor="Hand" ToolTip="Close (Esc)"
                            MouseLeftButtonUp="Close_MouseLeftButtonUp">
                        <TextBlock Text="✕" Foreground="{StaticResource Muted}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel x:Name="Body" />

                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="Hint" Foreground="{StaticResource Muted}" FontSize="11.5" Text="Click for the next one" />
                    <TextBlock x:Name="Dots" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontSize="11.5" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
