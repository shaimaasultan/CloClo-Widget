<Window x:Class="CloCloWidget.TrendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloClo — Trending"
        Width="580" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#241a10">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#2a2019" />
        <SolidColorBrush x:Key="Edge" Color="#8a6a2f" />
        <SolidColorBrush x:Key="Text" Color="#f3ecdd" />
        <SolidColorBrush x:Key="Muted" Color="#cbbfa8" />
        <SolidColorBrush x:Key="Accent" Color="#e6c476" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#c9a24b" />
            <Setter Property="Foreground" Value="#241e1a" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TrendLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: source badge, title and the day, then the picker and Refresh. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Accent}" VerticalAlignment="Top">
                <TextBlock x:Name="SourceGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Foreground="#241a10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="HeaderSubtitle" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="ChoiceBox" Width="150" DisplayMemberPath="Name" SelectionChanged="ChoiceBox_SelectionChanged"
                          AutomationProperties.Name="Country or language" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,8" FontSize="12"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TrendList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"
                                        Background="{Binding RankBrush}">
                                    <TextBlock Text="{Binding Rank}" FontWeight="Bold" FontSize="15" Foreground="#241a10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" FlowDirection="{Binding TitleFlow}">
                                        <Hyperlink Style="{StaticResource TrendLink}" NavigateUri="{Binding Url}" RequestNavigate="Link_RequestNavigate"
                                                   ToolTip="{Binding UrlHint}">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0" FontSize="12.5">
                                        <Run Text="{Binding Measure, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                        <Run Text="{Binding ChangeText, Mode=OneWay}" Foreground="{Binding ChangeBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Visibility="{Binding DescriptionVisibility}" FlowDirection="{Binding DescriptionFlow}"
                                               Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                                               Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" Opacity="0.85"
                                               TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="66" />
                                    <ItemsControl ItemsSource="{Binding Links}" Visibility="{Binding LinksVisibility}" Margin="0,6,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" FlowDirection="{Binding Flow}">
                                                    <Run Text="▸ " Foreground="{StaticResource Accent}" />
                                                    <Hyperlink Style="{StaticResource TrendLink}" NavigateUri="{Binding Url}" RequestNavigate="Link_RequestNavigate"
                                                               ToolTip="{Binding Url}">
                                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                                    </Hyperlink>
                                                    <Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" Background="#3c1512" Foreground="#f3ecdd" />
        </Grid>
    </Grid>
</Window>
