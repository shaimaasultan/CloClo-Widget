<!--
  CloClo's Windows Installer package: what CloClo-Setup.exe installs.
  Per-machine, into Program Files\CloClo (only administrators can change it),
  with Start menu and desktop shortcuts plus a current-user startup entry.
  A newer package replaces an older one in place;
  a running CloClo is asked to close first (and ended if it doesn't). Windows
  Installer rolls everything back if anything fails.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="CloClo" Manufacturer="CloClo" Version="$(Version)"
           UpgradeCode="1E9ECC83-FCA5-44EC-BEC2-39493DE5F789"
           Scope="perMachine" Compressed="yes">

    <!-- Two builds within the same ten minutes share a version: the newer
         one still replaces the older instead of installing beside it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of CloClo is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <SummaryInformation Description="CloClo desktop widget - weather, clock, shortcuts, daily quote and word, and the Layer Sudoku daily game" />
    <Property Id="ARPCOMMENTS" Value="Desktop widget: weather, clock and date, media and notification shortcuts, stopwatch, daily quote, Arabic word, joke and fact, and the Layer Sudoku daily game." />

    <Icon Id="CloClo.ico" SourceFile="..\Assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="CloClo.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Block direct MSI and silent installs while a separate script
         installer is still registered for this user or machine. The bundle disables
         its Install button and explains how to remove the old install. -->
    <Property Id="LEGACYSCRIPTINSTALLUSER">
      <RegistrySearch Id="LegacyScriptInstallUserSearch" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\CloClo"
                      Name="InstallLocation" Type="raw" />
    </Property>
    <Property Id="LEGACYSCRIPTINSTALLMACHINE">
      <RegistrySearch Id="LegacyScriptInstallMachineSearch" Root="HKLM"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\CloClo"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="REMOVE=&quot;ALL&quot; OR (NOT LEGACYSCRIPTINSTALLUSER AND NOT LEGACYSCRIPTINSTALLMACHINE)"
            Message="Uninstall the older script-installed CloClo from Settings > Apps > Installed apps, then run CloClo Setup again." />

    <!-- Close a running CloClo (it saves its settings on close), and end it
         if it hasn't gone after a few seconds, so its files can be replaced. -->
    <util:CloseApplication Id="CloseCloClo" Target="CloCloWidget.exe" CloseMessage="yes"
                           TerminateProcess="1" Timeout="5" RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CloClo">
        <!-- The signed app, native DLLs, and pinned local transcription model. -->
        <Files Include="$(AppDir)\*.exe" />
        <Files Include="$(AppDir)\*.dll" />
        <Files Include="$(AppDir)\ggml-base.bin" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="CloCloShortcut" Name="CloClo" Description="CloClo desktop widget"
                  Target="[INSTALLFOLDER]CloCloWidget.exe" WorkingDirectory="INSTALLFOLDER" />
        <!-- Windows Installer tracks a shortcut through a value in HKCU
             (ICE38/ICE43); it's just a marker. -->
        <RegistryValue Root="HKCU" Key="Software\CloClo" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- A per-machine DesktopFolder resolves to the public desktop. The
         shortcut targets only the signed executable under Program Files. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="CloCloDesktopShortcut" Name="CloClo" Description="CloClo desktop widget"
                  Target="[INSTALLFOLDER]CloCloWidget.exe" WorkingDirectory="INSTALLFOLDER" />
        <!-- MSI classifies DesktopFolder shortcuts as profile resources for
             component validation, even when ALLUSERS routes this directory
             to the public desktop. Use its required HKCU key path. -->
        <RegistryValue Root="HKCU" Key="Software\CloClo" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Only the installing user's Run key is used. A common Startup-folder
         shortcut would start CloClo for every account on this PC. The
         executable itself still runs unelevated at sign-in. -->
    <Component Id="CurrentUserStartup" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="CloCloWidget" Type="string"
                     Value="&quot;[INSTALLFOLDER]CloCloWidget.exe&quot; --wait-for-security" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
